{
    "name": "_filter_distort",
    "displayname": "filter_distort",
    "type": "filter",
    "parameters": [
        {
            "name": "g_DistortScale",
            "displayname": "Scale",
            "type": "float",
            "elements": 1,
			"arraysize": 0,
			"default": 5.0,
            "min": 0.01,
            "max": 32.0
        },
		
		{
            "name": "g_DistortAmount",
            "displayname": "Amount",
            "type": "float",
            "elements": 1,
			"arraysize": 0,
			"default": 50.0,
            "min": 0.0,
            "max": 512.0
        },
		
		{
            "name": "g_DistortOffset",
            "displayname": "Offset",
            "type": "float",
						"fields": ["X","Y"],
            "elements": 2,
			"arraysize": 0,
			"default": [0.0, 0.0],
			"min": [0.0, 0.0],
			"max": [1.0, 1.0]
        },
		
		{
            "name": "g_DistortTexture",
            "displayname": "Distort Texture",
            "type": "sampler",
            "elements": 1,
			"arraysize": 0,
			"default": "_filter_distort_smoothnoise",        
			"options": "repeat|filter"
        }
    ]
}