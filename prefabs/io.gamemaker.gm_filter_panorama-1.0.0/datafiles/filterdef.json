        	"elements": 1,
			"arraysize": 0,
			"default": 0.0,
			"min": 0.0,
			"max": 1.0
      	},
		{
        	"name": "g_PanoramaTexture",
        	"displayname": "Panorama Texture",
        	"type": "sampler",
