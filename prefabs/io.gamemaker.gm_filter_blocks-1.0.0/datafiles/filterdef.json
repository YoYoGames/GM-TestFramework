{
	"name": "_filter_blocks",
	"displayname": "filter_blocks",
	"type": "filter",
	"parameters": [
		{
        	"name": "g_BlocksPosition",
        	"displayname": "View Position",
        	"type": "float",
			"fields": ["X","Y","Z"],
        	"elements": 3,
			"arraysize": 0,
			"default": [0.0, 0.0, 5.0],
			"min": [-64.0, -64.0, 0.0],
			"max": [64.0, 64.0, 64.0]
      	},
		{
        	"name": "g_BlocksPerspective",
        	"displayname": "Perspective",
        	"type": "float",
        	"elements": 1,
			"arraysize": 0,
			"default": 0.5,
			"min": 0.1,
			"max": 1.0
      	},
		{
        	"name": "g_BlocksShading",
        	"displayname": "Shading",
        	"type": "float",
        	"elements": 1,
			"arraysize": 0,
			"default": 0.8,
			"min": 0.0,
			"max": 1.0
      	},
		{
        	"name": "g_BlocksFaceLight",
        	"displayname": "Face Lighting",
        	"type": "float",
			"fields": ["X","Y","Z"],
        	"elements": 3,
			"arraysize": 0,
			"default": [0.5, 0.8, 1.0],
			"min": [0.0, 0.0, 0.0],
			"max": [1.0, 1.0, 1.0]
      	},{
        	"name": "g_BlocksTiles",
        	"displayname": "Block Tiles",
        	"type": "float",
        	"elements": 2,
			"arraysize": 0,
			"default": [2.0, 2.0],
			"min": [1.0, 1.0],
			"max": [256.0, 256.0]
      	},
		{
        	"name": "g_BlocksTexture",
        	"displayname": "Blocks Texture",
        	"type": "sampler",
        	"elements": 1,
			"arraysize": 0,
			"default": "_filter_blocks_texture",
			"options": "repeat"
      	}
  	]
}
